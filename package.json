    "test": "node --import tsx --test \"src/main/**/*.test.ts\"",
    "package": "electron-vite build && electron-builder --mac"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "private": true,
  "dependencies": {
    "date-fns": "^4.4.0",
